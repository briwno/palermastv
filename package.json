{
  "name": "palermastv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "next build",
    "start": "next start",
    "test": "node --test",
    "lint": "eslint .",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:signal": "wrangler dev --config services/signaling/wrangler.jsonc --port 8787",
    "deploy:signal": "wrangler deploy --config services/signaling/wrangler.jsonc"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "wrangler": "4.92.0"
  }
}
